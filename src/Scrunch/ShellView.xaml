<UserControl
    x:Class="Scrunch.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Scrunch"
    FontFamily="{StaticResource ShellFontFamily}" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <x:Double x:Key="ShellDividerOpacity">0.5</x:Double>
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <x:Double x:Key="ShellDividerOpacity">1</x:Double>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="ShellActionStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="FontFamily" Value="{StaticResource ShellFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Padding="16,8,16,10">
        <Grid x:Name="HomePanel" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Scrunch" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
                <Button x:Name="NewButton" Style="{StaticResource ShellActionStyle}" AutomationProperties.Name="New note" AutomationProperties.AutomationId="NewNote" HorizontalAlignment="Right" Click="New_Click" ToolTipService.ToolTip="New note (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        <TextBlock Text="New note"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="1">
            <TextBox x:Name="SearchBox" PlaceholderText="Search notes…" MinHeight="32" Padding="30,5,8,5" FontSize="13"
                            AutomationProperties.Name="Search notes" AutomationProperties.AutomationId="SearchNotes"
                            TextChanged="Search_Changed">
                <TextBox.Resources>
                    <!-- Only search gets these fills. Keep WinUI's native border,
                         accent focus cue, text, selection and disabled states. -->
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#32FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#4AFFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#73FFFFFF"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#16000000"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#20000000"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#41000000"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource SystemColorWindowColor}"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SystemColorWindowColor}"/>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TextBox.Resources>
            </TextBox>
            <FontIcon Glyph="&#xE721;" FontSize="13" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <Grid Grid.Row="2" MinHeight="52" MaxHeight="350">
                <ListView x:Name="NotesList" IsItemClickEnabled="True" ItemClick="Note_Click"
                          SelectionMode="Single" KeyDown="Notes_KeyDown" AutomationProperties.Name="Notes"
                          AutomationProperties.AutomationId="NotesList" HorizontalContentAlignment="Stretch" Padding="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="50"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:NoteListRow">
                            <Grid Padding="0,6" ColumnSpacing="10" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{x:Bind Swatch, Mode=OneWay}" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="0.75" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{x:Bind Preview, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyLabel" TextWrapping="Wrap" Margin="8,12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <StackPanel Grid.Row="3" Spacing="2">
                <Border Height="1" Margin="0,2,0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="{ThemeResource ShellDividerOpacity}"/>
                <Button x:Name="UndoButton" Style="{StaticResource ShellActionStyle}" FontWeight="Normal" AutomationProperties.Name="Undo last discard" AutomationProperties.AutomationId="UndoDiscard" HorizontalAlignment="Left" Click="Undo_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7A7;" FontSize="13"/><TextBlock Text="Undo last discard"/></StackPanel>
                </Button>
                <Grid>
                    <Button x:Name="SettingsButton" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="Settings" AutomationProperties.AutomationId="Settings" Click="Settings_Click" Style="{StaticResource ShellActionStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="13"/><TextBlock Text="Settings"/></StackPanel>
                    </Button>
                    <Button x:Name="QuitButton" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="Quit" AutomationProperties.AutomationId="Quit" HorizontalAlignment="Right" Click="Quit_Click" Style="{StaticResource ShellActionStyle}" ToolTipService.ToolTip="Save notes and quit Scrunch">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7E8;" FontSize="13"/><TextBlock Text="Quit"/></StackPanel>
                    </Button>
                </Grid>
                <Grid x:Name="ShortcutNotice" Visibility="Collapsed" Margin="8,4,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="12" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="Ctrl+Alt+N is in use.&#xA;Use New note or Ctrl+N." FontSize="12" LineHeight="16" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="DismissShortcutNotice" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="4" MinWidth="24" MinHeight="24" VerticalAlignment="Top"
                            AutomationProperties.Name="Dismiss shortcut notice" AutomationProperties.AutomationId="DismissShortcutNotice" Click="DismissShortcutNotice_Click" ToolTipService.ToolTip="Dismiss">
                        <FontIcon Glyph="&#xE711;" FontSize="10"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="TrayNotice" Visibility="Collapsed" Margin="8,4,8,0" FontSize="12" TextWrapping="Wrap"
                           Text="The tray icon is unavailable. Keep this window open; use Quit to exit."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="SettingsPanel" Visibility="Collapsed" RowSpacing="12" MaxHeight="460">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BackButton" AutomationProperties.Name="Back to notes" AutomationProperties.AutomationId="BackToNotes" Click="Back_Click" Style="{StaticResource SubtleButtonStyle}"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button>
                <TextBlock Text="Settings" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="18" Padding="0,0,8,8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Note text" FontWeight="SemiBold"/>
                        <ComboBox x:Name="NoteFont" Header="Font" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="NoteFont" SelectionChanged="Typography_Changed"/>
                        <NumberBox x:Name="NoteFontSize" Header="Font size" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="2" AutomationProperties.AutomationId="NoteFontSize" ValueChanged="FontSize_Changed"/>
                        <TextBlock x:Name="FontPreview" Text="A little thing to remember…" TextWrapping="Wrap"/>
                        <TextBlock Text="Applies to all notes, including new ones." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <StackPanel Spacing="12">
                        <TextBlock Text="New notes" FontWeight="SemiBold"/>
                        <ComboBox x:Name="DefaultColour" Header="Paper colour" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DefaultColour" SelectionChanged="Defaults_Changed"/>
                        <ToggleSwitch x:Name="DefaultPinned" Header="Always on top" OnContent="On" OffContent="Off" AutomationProperties.AutomationId="DefaultPinned" Toggled="Defaults_Changed"/>
                        <ToggleSwitch x:Name="DefaultReducedMotion" Header="Reduce motion" OnContent="On" OffContent="Follow Windows" AutomationProperties.AutomationId="DefaultReducedMotion" Toggled="Defaults_Changed"/>
                        <TextBlock Text="Applies to new notes. Change an existing note from its top-edge menu." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Global shortcut" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ShortcutLabel" TextWrapping="Wrap"/>
                        <TextBlock Text="Closing this window keeps Scrunch in the tray. Use Quit to save and exit." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="StartWithWindows" Header="Start Scrunch when I sign in" OnContent="On" OffContent="Off" AutomationProperties.AutomationId="StartWithWindows" Toggled="Startup_Changed"/>
                        <TextBlock x:Name="StartupMessage" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="RemoveStartup" Content="Remove startup entry" Click="RemoveStartup_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="DataFolderButton" Content="Open data folder" AutomationProperties.AutomationId="OpenDataFolder" Click="DataFolder_Click"/>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="VersionLabel"/>
                        <TextBlock Text="Little notes, right where you leave them." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
