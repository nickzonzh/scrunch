<UserControl x:Class="Noot_Proto.NoteView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="NoteView_Loaded" Unloaded="NoteView_Unloaded">
 <Grid x:Name="Root" Width="460" Height="480">
  <Grid x:Name="TiltRoot">
   <Border x:Name="RestShadow" Width="400" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5">
    <Border.Background><ImageBrush x:Name="RestShadowBrush" Stretch="Fill"/></Border.Background>
   </Border>
   <!-- Native editing at rest; a cached snapshot follows the mesh during motion. -->
   <Grid x:Name="SourceHost" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border x:Name="Paper" Width="300" Height="320" Background="#FDEE9E" CornerRadius="1">
     <Grid>
      <Border IsHitTestVisible="False"><Border.Background>
       <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1"><GradientStop Color="#20FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.3"/><GradientStop Color="#08000000" Offset="1"/></LinearGradientBrush>
      </Border.Background></Border>
      <Canvas x:Name="Fibres" IsHitTestVisible="False"/>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border x:Name="GrabZone" Background="#06000000" ToolTipService.ToolTip="Pick up the top edge"/>
       <TextBox x:Name="NoteText" Grid.Row="1" Padding="20,4,20,18" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent"
        BorderThickness="0" FontFamily="{StaticResource NoteFontFamily}" FontSize="23" Foreground="#453D2D" SelectionHighlightColor="#50BDA246"
        PlaceholderText="A little thing to remember…" IsSpellCheckEnabled="False" AutomationProperties.Name="Note text"
        Text="Leave me where&#x0a;I matter.&#x0a;&#x0a;Pick up my top edge.&#x0a;Put me somewhere good.">
        <TextBox.Resources>
         <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
         <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
         <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
         <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
        </TextBox.Resources>
       </TextBox>
       <Border x:Name="Grip" Grid.Row="1" Width="24" Height="24" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTipService.ToolTip="Resize paper">
        <Path Data="M 12,19 L 19,12" Stroke="#506A5934" StrokeThickness="1"/>
       </Border>
      </Grid>
     </Grid>
    </Border>
   </Grid>
   <!-- The mesh can bend outside the flat sheet. Give its XAML host the entire
        padded window, rather than clipping composition output to paper bounds. -->
   <Grid x:Name="MeshHost" IsHitTestVisible="False"/>
  </Grid>
 </Grid>
</UserControl>
