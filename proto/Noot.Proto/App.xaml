<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Noot_Proto.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Noot_Proto">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">/Assets/Fonts/InterVariable.ttf#Inter Variable, Segoe UI Variable Text, Segoe UI, Segoe UI Emoji</FontFamily>
            <FontFamily x:Key="ShellFontFamily">/Assets/Fonts/InterVariable.ttf#Inter Variable, Segoe UI Variable Text, Segoe UI, Segoe UI Emoji</FontFamily>
            <!-- Only the paper editor uses handwriting. WinUI/DirectWrite supplies
                 script-aware system and emoji fallback for missing glyphs. -->
            <FontFamily x:Key="NoteFontFamily">/Assets/Fonts/DrawablyPen.ttf#Drawably Pen, Segoe UI Variable Text, Segoe UI, Segoe UI Emoji</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
